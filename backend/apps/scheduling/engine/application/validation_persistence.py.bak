from __future__ import annotations

from collections.abc import Iterable
from typing import Any

from django.db import transaction

from apps.scheduling.engine.validation.result import ValidationFinding
from apps.scheduling.models import (
    DayOfWeek,
    SchedulingRun,
    ValidationResult,
)


class ValidationPersistenceError(Exception):
    """Raised when validation findings cannot be persisted."""


def _get_value(
    finding: ValidationFinding,
    name: str,
    default: Any = None,
) -> Any:
    """
    Safely retrieve a value from a ValidationFinding.

    The validation engine remains independent from Django persistence.
    This helper allows the persistence layer to consume the domain object
    without making the domain layer depend on Django models.
    """
    return getattr(finding, name, default)


def _normalise_day(
    day: Any,
) -> str | None:
    """
    Convert a domain day value into the database representation.
    """
    if day is None:
        return None

    if isinstance(day, DayOfWeek):
        return day.value

    value = getattr(day, "value", day)

    if value is None:
        return None

    value = str(value).upper()

    valid_days = {
        choice.value
        for choice in DayOfWeek
    }

    if value in valid_days:
        return value

    aliases = {
        "MONDAY": DayOfWeek.MONDAY,
        "TUESDAY": DayOfWeek.TUESDAY,
        "WEDNESDAY": DayOfWeek.WEDNESDAY,
        "THURSDAY": DayOfWeek.THURSDAY,
        "FRIDAY": DayOfWeek.FRIDAY,
    }

    return aliases.get(value, value)


def _extract_context(
    finding: ValidationFinding,
) -> dict[str, Any]:
    """
    Extract structured domain context from a validation finding.

    The domain validation layer can attach context without knowing
    anything about Django persistence.
    """
    context = _get_value(finding, "context", None)

    if context is None:
        context = _get_value(finding, "details", None)

    if context is None:
        return {}

    if isinstance(context, dict):
        return dict(context)

    try:
        return dict(context)
    except (TypeError, ValueError):
        return {
            "value": str(context),
        }


def _extract_model_id(
    finding: ValidationFinding,
    field_name: str,
) -> Any:
    """
    Extract an optional model/object ID from a finding.

    Supports both direct IDs such as teacher_id and domain objects
    such as teacher.
    """
    direct_id = _get_value(
        finding,
        f"{field_name}_id",
        None,
    )

    if direct_id is not None:
        return direct_id

    obj = _get_value(
        finding,
        field_name,
        None,
    )

    if obj is None:
        return None

    return getattr(obj, "id", None)


def _build_validation_result_kwargs(
    finding: ValidationFinding,
    scheduling_run: SchedulingRun,
) -> dict[str, Any]:
    """
    Convert one domain ValidationFinding into ValidationResult fields.
    """
    severity = _get_value(
        finding,
        "severity",
        None,
    )

    category = _get_value(
        finding,
        "category",
        None,
    )

    message = _get_value(
        finding,
        "message",
        "",
    )

    if hasattr(severity, "value"):
        severity = severity.value

    if hasattr(category, "value"):
        category = category.value

    if not severity:
        raise ValidationPersistenceError(
            "Validation finding is missing severity."
        )

    if not category:
        raise ValidationPersistenceError(
            "Validation finding is missing category."
        )

    if not message:
        raise ValidationPersistenceError(
            "Validation finding is missing message."
        )

    return {
        "scheduling_run": scheduling_run,
        "severity": str(severity),
        "category": str(category),
        "message": str(message),
        "details": _extract_context(finding),
        "teacher_id": _extract_model_id(
            finding,
            "teacher",
        ),
        "teaching_group_id": _extract_model_id(
            finding,
            "teaching_group",
        ),
        "period_id": _extract_model_id(
            finding,
            "period",
        ),
        "day": _normalise_day(
            _get_value(finding, "day", None),
        ),
        "room_id": _extract_model_id(
            finding,
            "room",
        ),
        "timetable_entry_id": _extract_model_id(
            finding,
            "timetable_entry",
        ),
        "is_resolved": False,
    }


@transaction.atomic
def persist_validation_findings(
    scheduling_run: SchedulingRun,
    findings: Iterable[ValidationFinding],
) -> list[ValidationResult]:
    """
    Persist validation findings for a scheduling run.

    Existing validation results belonging to the same scheduling run
    are replaced. This makes the operation idempotent and prevents
    duplicate validation records when the same timetable is validated
    more than once during one application workflow.

    Parameters
    ----------
    scheduling_run:
        The SchedulingRun receiving the validation results.

    findings:
        Iterable of ValidationFinding domain objects.

    Returns
    -------
    list[ValidationResult]
        The newly persisted validation results.
    """
    if scheduling_run.pk is None:
        raise ValidationPersistenceError(
            "SchedulingRun must be saved before validation "
            "findings can be persisted."
        )

    findings = list(findings)

    ValidationResult.objects.filter(
        scheduling_run=scheduling_run,
    ).delete()

    validation_results = [
        ValidationResult(
            **_build_validation_result_kwargs(
                finding,
                scheduling_run,
            )
        )
        for finding in findings
    ]

    if not validation_results:
        return []

    return ValidationResult.objects.bulk_create(
        validation_results,
    )


@transaction.atomic
def persist_validation_summary(
    scheduling_run: SchedulingRun,
    summary: Any,
) -> list[ValidationResult]:
    """
    Persist all findings contained in a ValidationSummary.

    The validation domain remains completely independent from Django.
    Only this application-layer function knows how to translate the
    summary into database records.
    """
    if summary is None:
        raise ValidationPersistenceError(
            "Validation summary cannot be None."
        )

    findings = getattr(
        summary,
        "findings",
        None,
    )

    if findings is None:
        raise ValidationPersistenceError(
            "Validation summary does not contain findings."
        )

    return persist_validation_findings(
        scheduling_run=scheduling_run,
        findings=findings,
    )


@transaction.atomic
def replace_validation_results(
    scheduling_run: SchedulingRun,
    findings: Iterable[ValidationFinding],
) -> list[ValidationResult]:
    """
    Explicit alias for replacing all validation results for a run.

    This function exists to make application-service intent obvious
    when validation is executed repeatedly.
    """
    return persist_validation_findings(
        scheduling_run=scheduling_run,
        findings=findings,
    )


def clear_validation_results(
    scheduling_run: SchedulingRun,
) -> int:
    """
    Delete all validation results belonging to a scheduling run.

    Returns the number of deleted records.
    """
    if scheduling_run.pk is None:
        raise ValidationPersistenceError(
            "SchedulingRun must be saved before validation results "
            "can be cleared."
        )

    deleted_count, _ = ValidationResult.objects.filter(
        scheduling_run=scheduling_run,
    ).delete()

    return deleted_count