.timetable-page {
  width: 100%;
  max-width: 100%;
  margin: 0;
  padding: 18px 20px 24px;
  box-sizing: border-box;
}

.timetable-toolbar {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 14px;
}

.timetable-toolbar h1 {
  margin: 3px 0 2px;
  font-size: 24px;
  line-height: 1.15;
  font-weight: 750;
  letter-spacing: -0.02em;
}

.timetable-toolbar p {
  margin: 0;
  color: #64748b;
  font-size: 12px;
}

.eyebrow {
  display: block;
  color: #2563eb;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.timetable-refresh {
  flex: 0 0 auto;
  white-space: nowrap;
}

.timetable-refresh svg.spin,
.timetable-state svg.spin {
  animation: timetable-spin 0.9s linear infinite;
}

@keyframes timetable-spin {
  to {
    transform: rotate(360deg);
  }
}

.timetable-error {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-bottom: 12px;
  padding: 10px 12px;
  border: 1px solid #fecaca;
  border-radius: 8px;
  background: #fef2f2;
  color: #991b1b;
  font-size: 12px;
}

.timetable-state {
  min-height: 180px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 8px;
  border: 1px solid #dbe3ef;
  border-radius: 10px;
  background: #ffffff;
  color: #64748b;
  font-size: 13px;
}

.timetable-state strong {
  color: #334155;
  font-size: 14px;
}

.timetable-heading-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 8px;
  padding: 9px 12px;
  border: 1px solid #cbd5e1;
  border-bottom: 0;
  border-radius: 8px 8px 0 0;
  background: #ffffff;
}

.timetable-heading-card > div:first-child {
  display: flex;
  flex-direction: column;
  min-width: 220px;
}

.timetable-heading-card strong {
  color: #0f172a;
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.04em;
}

.timetable-heading-card > div:first-child span {
  margin-top: 2px;
  color: #475569;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.timetable-meta {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 5px;
  flex-wrap: wrap;
}

.timetable-meta span {
  padding: 4px 7px;
  border: 1px solid #e2e8f0;
  border-radius: 5px;
  background: #f8fafc;
  color: #475569;
  font-size: 9px;
  font-weight: 700;
  white-space: nowrap;
}

.timetable-card {
  width: 100%;
  border: 1px solid #cbd5e1;
  border-radius: 0 0 8px 8px;
  background: #ffffff;
  overflow: hidden;
}

.timetable-scroll {
  width: 100%;
  overflow-x: auto;
  overflow-y: hidden;
}

.whole-school-timetable {
  width: 100%;
  min-width: 1180px;
  border-collapse: collapse;
  table-layout: fixed;
  font-size: 10px;
}

.whole-school-timetable th,
.whole-school-timetable td {
  border: 1px solid #cbd5e1;
  box-sizing: border-box;
}

.whole-school-timetable col.day-column {
  width: 42px;
}

.whole-school-timetable col.class-column {
  width: 78px;
}

.whole-school-timetable col.period-column {
  width: 82px;
}

.whole-school-timetable col.special-column {
  width: 64px;
}

.whole-school-timetable thead th {
  height: 42px;
  padding: 4px 3px;
  background: #e2e8f0;
  color: #0f172a;
  text-align: center;
  vertical-align: middle;
}

.whole-school-timetable .days-header,
.whole-school-timetable .class-header {
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.04em;
}

.whole-school-timetable .timetable-header {
  font-weight: 800;
}

.timetable-header span {
  display: block;
  font-size: 10px;
  line-height: 1.05;
  white-space: nowrap;
}

.timetable-header small {
  display: block;
  margin-top: 3px;
  color: #64748b;
  font-size: 7px;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}

.timetable-header.break,
.timetable-header.activity {
  background: #f1f5f9;
}

.whole-school-timetable tbody tr {
  height: 44px;
}

.day-label {
  width: 42px;
  padding: 3px;
  background: #f8fafc;
  color: #0f172a;
  text-align: center;
  vertical-align: middle;
  font-size: 10px;
  font-weight: 850;
}

.class-label {
  width: 78px;
  padding: 3px 4px;
  background: #f8fafc;
  color: #334155;
  text-align: left;
  vertical-align: middle;
  font-size: 8px;
  font-weight: 800;
  line-height: 1.1;
}

.lesson-cell {
  padding: 2px;
  background: #ffffff;
  text-align: center;
  vertical-align: middle;
}

.lesson-stack {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  gap: 2px;
}

.lesson-entry {
  min-height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2px 3px;
  border: 1px solid #dbe3ef;
  border-radius: 3px;
  background: #f8fafc;
  box-sizing: border-box;
  overflow: hidden;
}

.lesson-entry strong {
  display: block;
  color: #1e293b;
  font-size: 8px;
  font-weight: 800;
  line-height: 1.05;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.lesson-entry.assembly-entry {
  border-color: #cbd5e1;
  background: #f1f5f9;
}

.lesson-entry.assembly-entry strong {
  color: #475569;
  font-size: 7px;
  letter-spacing: 0.03em;
}

.empty-slot {
  color: #cbd5e1;
  font-size: 10px;
  font-weight: 600;
}

.special-cell {
  padding: 2px;
  text-align: center;
  vertical-align: middle;
  background: #f8fafc;
}

.special-cell strong {
  display: block;
  color: #64748b;
  font-size: 7px;
  font-weight: 850;
  letter-spacing: 0.02em;
  line-height: 1;
  white-space: nowrap;
}

.special-cell small {
  display: block;
  margin-top: 3px;
  color: #94a3b8;
  font-size: 6px;
  line-height: 1;
  white-space: nowrap;
}

.special-cell.activity {
  background: #f1f5f9;
}

.timetable-legend {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 7px 10px;
  border-top: 1px solid #cbd5e1;
  background: #f8fafc;
  color: #64748b;
  font-size: 8px;
}

.timetable-legend span {
  white-space: nowrap;
}

.timetable-legend strong {
  color: #334155;
}

/* Keep the timetable compact on normal laptop/desktop screens. */
@media (max-width: 1350px) {
  .timetable-page {
    padding-left: 12px;
    padding-right: 12px;
  }

  .whole-school-timetable {
    min-width: 1080px;
  }

  .whole-school-timetable col.day-column {
    width: 38px;
  }

  .whole-school-timetable col.class-column {
    width: 70px;
  }

  .whole-school-timetable col.period-column {
    width: 75px;
  }

  .whole-school-timetable col.special-column {
    width: 58px;
  }

  .whole-school-timetable tbody tr {
    height: 40px;
  }

  .lesson-entry {
    min-height: 25px;
  }
}

/* Print/export: force the complete timetable onto one landscape sheet. */
@media print {
  @page {
    size: A4 landscape;
    margin: 6mm;
  }

  body {
    margin: 0;
    background: #ffffff;
  }

  .sidebar,
  .topbar,
  .timetable-toolbar,
  .timetable-error {
    display: none !important;
  }

  .main-area,
  .content {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .timetable-page {
    width: 100%;
    padding: 0;
  }

  .timetable-heading-card {
    margin-bottom: 4px;
    padding: 5px 7px;
  }

  .timetable-card {
    border-radius: 0;
  }

  .timetable-scroll {
    overflow: visible;
  }

  .whole-school-timetable {
    width: 100%;
    min-width: 0;
    table-layout: fixed;
    font-size: 7px;
  }

  .whole-school-timetable col.day-column {
    width: 4%;
  }

  .whole-school-timetable col.class-column {
    width: 7%;
  }

  .whole-school-timetable col.period-column {
    width: 7.2%;
  }

  .whole-school-timetable col.special-column {
    width: 5.6%;
  }

  .whole-school-timetable thead th {
    height: 27px;
    padding: 2px;
  }

  .whole-school-timetable tbody tr {
    height: 31px;
    break-inside: avoid;
  }

  .day-label {
    width: auto;
    font-size: 7px;
  }

  .class-label {
    width: auto;
    font-size: 6px;
  }

  .timetable-header span {
    font-size: 7px;
  }

  .timetable-header small {
    margin-top: 1px;
    font-size: 5px;
  }

  .lesson-entry {
    min-height: 18px;
    padding: 1px;
  }

  .lesson-entry strong {
    font-size: 6px;
  }

  .lesson-entry.assembly-entry strong {
    font-size: 5px;
  }

  .special-cell strong {
    font-size: 5px;
  }

  .special-cell small {
    margin-top: 1px;
    font-size: 4px;
  }

  .timetable-legend {
    padding: 3px 5px;
    font-size: 5px;
  }
}
