import { useState } from "react";
import type { FormEvent } from "react";
import { Bot, Send, Sparkles, User, Loader2 } from "lucide-react";

type ChatMessage = {
  role: "user" | "assistant";
  content: string;
};

type ChatResponse = {
  success?: boolean;
  content?: string;
  error?: string;
};

async function sendAIMessage(message: string): Promise<string> {
  const response = await fetch("/api/ai/chat/", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
    },
    body: JSON.stringify({ message }),
  });

  let data: ChatResponse;

  try {
    data = (await response.json()) as ChatResponse;
  } catch {
    throw new Error(
      `AI gateway returned an invalid response (${response.status}).`,
    );
  }

  if (!response.ok || data.success !== true) {
    throw new Error(
      data.error ||
        `AI gateway request failed with HTTP ${response.status}.`,
    );
  }

  return data.content?.trim() || "The AI returned an empty response.";
}

function AIAssistant() {
  const [messages, setMessages] = useState<ChatMessage[]>([
    {
      role: "assistant",
      content:
        "Hello. I am the SmartTimetable AI Assistant. Ask me about timetable generation, scheduling, classes, teachers, subjects, constraints, or the school timetable.",
    },
  ]);

  const [input, setInput] = useState("");
  const [sending, setSending] = useState(false);
  const [error, setError] = useState("");

  async function handleSubmit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();

    const message = input.trim();

    if (!message || sending) {
      return;
    }

    setError("");

    setMessages((current) => [
      ...current,
      {
        role: "user",
        content: message,
      },
    ]);

    setInput("");
    setSending(true);

    try {
      const content = await sendAIMessage(message);

      setMessages((current) => [
        ...current,
        {
          role: "assistant",
          content,
        },
      ]);
    } catch (err) {
      const messageText =
        err instanceof Error
          ? err.message
          : "Unable to contact the SmartTimetable AI gateway.";

      setError(messageText);
    } finally {
      setSending(false);
    }
  }

  return (
    <>
      <style>{`
        .ai-page {
          min-height: calc(100vh - 40px);
          padding: 24px;
          box-sizing: border-box;
          background: #f5f8fc;
        }

        .ai-shell {
          width: 100%;
          max-width: 1180px;
          margin: 0 auto;
          display: flex;
          flex-direction: column;
          min-height: calc(100vh - 88px);
          background: #ffffff;
          border: 1px solid #d8e2ee;
          border-radius: 10px;
          overflow: hidden;
          box-shadow: 0 4px 18px rgba(26, 55, 87, 0.08);
        }

        .ai-header {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 20px;
          padding: 20px 24px;
          background: #173d67;
          color: white;
        }

        .ai-brand {
          display: flex;
          align-items: center;
          gap: 13px;
        }

        .ai-icon {
          width: 42px;
          height: 42px;
          display: flex;
          align-items: center;
          justify-content: center;
          border-radius: 9px;
          background: rgba(255, 255, 255, 0.14);
        }

        .ai-title {
          margin: 0;
          font-size: 21px;
          font-weight: 800;
        }

        .ai-subtitle {
          margin: 4px 0 0;
          font-size: 12px;
          color: #d9e7f5;
        }

        .ai-live {
          display: inline-flex;
          align-items: center;
          gap: 6px;
          padding: 6px 10px;
          border-radius: 5px;
          background: #218c48;
          color: white;
          font-size: 11px;
          font-weight: 800;
        }

        .ai-live-dot {
          width: 7px;
          height: 7px;
          border-radius: 50%;
          background: white;
        }

        .ai-messages {
          flex: 1;
          overflow-y: auto;
          padding: 24px;
          background: #f8fafc;
        }

        .ai-message {
          display: flex;
          gap: 11px;
          margin-bottom: 18px;
        }

        .ai-message.user {
          flex-direction: row-reverse;
        }

        .ai-avatar {
          flex: 0 0 34px;
          width: 34px;
          height: 34px;
          display: flex;
          align-items: center;
          justify-content: center;
          border-radius: 50%;
          background: #e5edf6;
          color: #234f79;
        }

        .ai-message.user .ai-avatar {
          background: #234f79;
          color: white;
        }

        .ai-bubble {
          max-width: min(78%, 800px);
          padding: 12px 15px;
          border-radius: 9px;
          background: white;
          border: 1px solid #dce5ef;
          color: #26384c;
          font-size: 14px;
          line-height: 1.55;
          white-space: pre-wrap;
        }

        .ai-message.user .ai-bubble {
          background: #e9f2fc;
          border-color: #c8dbef;
        }

        .ai-error {
          margin: 0 24px 12px;
          padding: 10px 13px;
          border: 1px solid #efb7b7;
          border-radius: 6px;
          background: #fff5f5;
          color: #a43a3a;
          font-size: 13px;
        }

        .ai-composer {
          padding: 16px 20px 20px;
          border-top: 1px solid #dce5ef;
          background: white;
        }

        .ai-form {
          display: flex;
          align-items: flex-end;
          gap: 10px;
        }

        .ai-input {
          flex: 1;
          min-height: 48px;
          max-height: 150px;
          resize: vertical;
          padding: 13px 14px;
          box-sizing: border-box;
          border: 1px solid #bdccdc;
          border-radius: 7px;
          outline: none;
          font: inherit;
          color: #243447;
          background: white;
        }

        .ai-input:focus {
          border-color: #3579b9;
          box-shadow: 0 0 0 3px rgba(53, 121, 185, 0.12);
        }

        .ai-send {
          height: 48px;
          padding: 0 18px;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          gap: 8px;
          border: 1px solid #1e639d;
          border-radius: 7px;
          background: #1f6eae;
          color: white;
          font-weight: 800;
          cursor: pointer;
        }

        .ai-send:disabled {
          opacity: 0.55;
          cursor: wait;
        }

        .ai-hint {
          margin: 8px 2px 0;
          color: #7b8795;
          font-size: 11px;
        }

        @keyframes ai-spin {
          from {
            transform: rotate(0deg);
          }

          to {
            transform: rotate(360deg);
          }
        }

        .ai-spinner {
          animation: ai-spin 1s linear infinite;
        }

        @media (max-width: 700px) {
          .ai-page {
            padding: 10px;
          }

          .ai-shell {
            min-height: calc(100vh - 20px);
          }

          .ai-header {
            padding: 15px;
          }

          .ai-live {
            display: none;
          }

          .ai-messages {
            padding: 15px;
          }

          .ai-bubble {
            max-width: 86%;
          }
        }

        @media print {
          .ai-page {
            display: none;
          }
        }
      `}</style>

      <main className="ai-page">
        <section className="ai-shell">
          <header className="ai-header">
            <div className="ai-brand">
              <div className="ai-icon">
                <Bot size={23} />
              </div>

              <div>
                <h1 className="ai-title">SmartTimetable AI Assistant</h1>
                <p className="ai-subtitle">
                  Local DeepSeek gateway • SmartTimetable Pro
                </p>
              </div>
            </div>

            <div className="ai-live">
              <span className="ai-live-dot" />
              AI ONLINE
            </div>
          </header>

          <div className="ai-messages">
            {messages.map((message, index) => (
              <div
                className={`ai-message ${message.role}`}
                key={`${message.role}-${index}`}
              >
                <div className="ai-avatar">
                  {message.role === "assistant" ? (
                    <Sparkles size={16} />
                  ) : (
                    <User size={16} />
                  )}
                </div>

                <div className="ai-bubble">{message.content}</div>
              </div>
            ))}

            {sending ? (
              <div className="ai-message assistant">
                <div className="ai-avatar">
                  <Sparkles size={16} />
                </div>

                <div className="ai-bubble">
                  <Loader2 size={16} className="ai-spinner" />
                  {" "}Thinking...
                </div>
              </div>
            ) : null}
          </div>

          {error ? <div className="ai-error">{error}</div> : null}

          <div className="ai-composer">
            <form className="ai-form" onSubmit={handleSubmit}>
              <textarea
                className="ai-input"
                value={input}
                onChange={(event) => setInput(event.target.value)}
                placeholder="Ask the SmartTimetable AI Assistant..."
                disabled={sending}
                rows={2}
              />

              <button
                type="submit"
                className="ai-send"
                disabled={sending || !input.trim()}
              >
                {sending ? (
                  <Loader2 size={17} className="ai-spinner" />
                ) : (
                  <Send size={17} />
                )}
                Send
              </button>
            </form>

            <p className="ai-hint">
              AI requests are sent through the SmartTimetable local backend
              gateway at /api/ai/chat/.
            </p>
          </div>
        </section>
      </main>
    </>
  );
}

export default AIAssistant;
